table Fondos
	lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000001

	column ruc_fondo
		dataType: string
		isKey
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000002
		summarizeBy: none
		sourceColumn: ruc_fondo

	column 'Nombre legal'
		dataType: string
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000003
		summarizeBy: none
		sourceColumn: fondo

	column Fondo = IF ( Fondos[nombre_corto] = "", Fondos[Nombre legal], Fondos[nombre_corto] )
		dataType: string
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000004
		summarizeBy: none

	column nombre_corto
		dataType: string
		isHidden
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000005
		summarizeBy: none
		sourceColumn: nombre_corto

	column Administradora = SWITCH ( Fondos[codigo_administradora], "POR CONFIRMAR", "Otras (por confirmar)", "FONDOS CERRADOS", "Fondos ya cerrados", "SIN ASIGNAR", "Fondos nuevos sin asignar", Fondos[codigo_administradora] )
		dataType: string
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000006
		summarizeBy: none

	column codigo_administradora
		dataType: string
		isHidden
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000007
		summarizeBy: none
		sourceColumn: administradora

	column 'Plazo de permanencia'
		dataType: string
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000008
		summarizeBy: none
		sourceColumn: plazo_permanencia

	column 'Tipo de fondo'
		dataType: string
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000009
		summarizeBy: none
		sourceColumn: tipo_fondo

	column ultimo_reporte
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-00000000000a
		summarizeBy: none
		sourceColumn: ultimo_reporte

		annotation UnderlyingDateTimeDataType = Date

	partition Fondos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(Web.Contents(URL_Datos & "fondos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"ruc_fondo", type text}, {"fondo", type text}, {"nombre_corto", type text}, {"administradora", type text}, {"plazo_permanencia", type text}, {"tipo_fondo", type text}, {"ultimo_reporte", type date}}, "en-US")
				in
				    Tipos

