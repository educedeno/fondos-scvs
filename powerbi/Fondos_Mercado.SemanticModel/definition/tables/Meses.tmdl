table Meses
	lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000101

	column Fecha
		dataType: dateTime
		isKey
		formatString: mmm yyyy
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000102
		summarizeBy: none
		sourceColumn: fecha

		annotation UnderlyingDateTimeDataType = Date

	column Mes
		dataType: string
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000103
		summarizeBy: none
		sourceColumn: Mes
		sortByColumn: Fecha

	column Año
		dataType: int64
		formatString: 0
		lineageTag: 6f1d2c10-0b3a-4d1e-9c11-000000000104
		summarizeBy: none
		sourceColumn: Año

	partition Meses = m
		mode: import
		source =
				let
				    Origen = Csv.Document(Web.Contents(URL_Datos & "fondos_patrimonio_mensual.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SoloFecha = Table.Distinct(Table.SelectColumns(Encabezados, {"fecha"})),
				    Tipos = Table.TransformColumnTypes(SoloFecha, {{"fecha", type date}}, "en-US"),
				    MesesEs = {"ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"},
				    ConMes = Table.AddColumn(Tipos, "Mes", each MesesEs{Date.Month([fecha]) - 1} & " " & Text.From(Date.Year([fecha])), type text),
				    ConAño = Table.AddColumn(ConMes, "Año", each Date.Year([fecha]), Int64.Type)
				in
				    ConAño

	annotation PBI_ResultType = Table

